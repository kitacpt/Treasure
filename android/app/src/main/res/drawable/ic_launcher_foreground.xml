<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      Cycle 0024 第一版做得有点像"几个圈叠在一起"，不像一枚戒指。
      Cycle 0025 重做：
        1. 椭圆压得更扁 — ry/rx ≈ 0.36（之前是 0.58），强烈俯视感
        2. 用更明显的圆环 (annulus)，不再有任何"额外切片" — 主体就一个
           evenOdd 椭圆环，简洁
        3. 内孔上偏 5 — 比之前的 4 大一点儿，让"前面厚 / 后面薄" 的透视
           特征更明显
        4. 渐变改纯垂直（顶亮底暗），更直接读出"上方有光从天而降照在
           凸面金属戒指上"
        5. 装饰物只留 4 条 — 外圈左上高光、外圈右下暗弧、内孔顶半暗
           （远端内壁）、内孔底半亮（近端内壁反顶光）。没有 rune，
           launcher 那么小看不清反而像污点
    -->

    <!-- 桌面投影：长椭圆软影，符合俯视角度 -->
    <path
        android:fillColor="#28000000"
        android:pathData="M54,80 m-28,0 a28,3.5 0 1,0 56,0 a28,3.5 0 1,0 -56,0" />

    <!-- 戒指主体：外椭圆 28×10、内孔椭圆 13×4 上偏 5，evenOdd 切出环。
         金色 5-stop 顶亮底暗渐变模拟光源从上方照在金属凸面。 -->
    <path
        android:fillType="evenOdd"
        android:pathData="M26,55 a28,10 0 1,0 56,0 a28,10 0 1,0 -56,0 Z M41,50 a13,4 0 1,1 26,0 a13,4 0 1,1 -26,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="45"
                android:endX="54"
                android:endY="65">
                <item android:offset="0.00" android:color="#FFFAE9A8" />
                <item android:offset="0.20" android:color="#FFE6BC68" />
                <item android:offset="0.55" android:color="#FFB07E36" />
                <item android:offset="0.85" android:color="#FF563911" />
                <item android:offset="1.00" android:color="#FF22150A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 外圈左上高光弧：金属凸面顶端最亮的一片，跨度大约 130° -->
    <path
        android:strokeColor="#FFFCEEC0"
        android:strokeWidth="1.1"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M28,53 a26,9 0 0,1 26,-9" />

    <!-- 外圈右下暗弧：转到金属凸面背光面时颜色压到几近全黑 -->
    <path
        android:strokeColor="#FF110804"
        android:strokeWidth="1.1"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M80,57 a26,9 0 0,1 -26,9" />

    <!-- 内孔顶半：背面内壁，被外圈遮天 → 暗 -->
    <path
        android:strokeColor="#FF180D04"
        android:strokeWidth="0.85"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M42,49.5 a12,3.5 0 0,1 24,0" />

    <!-- 内孔底半：近端内壁朝天反顶光 → 亮金线 -->
    <path
        android:strokeColor="#FFF6DE92"
        android:strokeWidth="0.7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M42.5,50.5 a11.5,3.5 0 0,0 23,0" />
</vector>

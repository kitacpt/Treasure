<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Cycle 0031：AI 调用熄屏保活。
         WAKE_LOCK 配合 service 持 PARTIAL_WAKE_LOCK，CPU 不睡 →
         OkHttp socket 不会断。
         FOREGROUND_SERVICE + FOREGROUND_SERVICE_DATA_SYNC：在 vivo / 华为 /
         OPPO 这种"激进省电"系统上，AI 调用期间 app 进了后台依然不会被秒杀。
         POST_NOTIFICATIONS：Android 13+ 前台 service 通知需要它（运行时申请）；
         没拿到也只是没图标，service 还能跑。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Cycle 0035：用户在设置页可以填自定义 OpenAI-兼容 base URL（Ollama
         / 自建反代 / 局域网 LLM 服务器都属于这种）。Android 9+ 默认禁明文，
         打开 cleartext 让 http://10.0.0.5:11434 / http://localhost 之类的本地
         地址能用；https 仍是优先。 -->
    <application
        android:name=".TreasureApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Treasure"
        android:supportsRtl="true"
        android:theme="@style/Theme.Treasure"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Treasure"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 京东 / 淘宝 / 浏览器分享商品链接过来 (text/plain)：用户在系统
                 分享面板里能选 "Treasure" 作为目标。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- 直接长按 / 点击 https / http URL "用 Treasure 打开" 也能落到这里。
                 不抢系统浏览器的默认（用户得显式选 "Treasure"）。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Cycle 0031：AI 调用期间起一个前台 service 顶住进程，熄屏 / 切后台
             都不会被 OEM 激进省电策略秒杀。type=dataSync 对应"app 内同步数据"，
             符合 AI 抽屉 / refine 场景。 -->
        <service
            android:name=".background.AiKeepAliveService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
